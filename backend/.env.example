# Server
PORT=3000

# Swagger basic auth (опционально — если не задано, /docs/api открыт без пароля)
SWAGGER_LOGIN=
SWAGGER_PASS=

# Вариант 1: один URL (Neon / Supabase / Render Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Вариант 2: отдельные поля (локальная разработка)
DB_HOST=localhost
DB_PORT=5432
DB_LOGIN=postgres
DB_PASSWORD=postgres
DB_NAME=photo-course

# Включить SSL без DATABASE_URL (например, если хост требует его)
DB_SSL=false
